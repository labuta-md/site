# Copy to .env.local for local work; in Vercel, add these under Settings → Environment Variables.
# Without the Supabase values the site runs in demo mode with test data.

# The public address of the site (no trailing slash). Used in QR codes and emails.
NEXT_PUBLIC_SITE_URL=https://labuta.md

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Never share it, never put it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Used to anonymise visitors' IP addresses for spam limits.
IP_HASH_SALT=

# Email notifications to owners (resend.com, free tier is enough to start)
RESEND_API_KEY=
EMAIL_FROM=Labuta <noreply@labuta.md>

# Telegram notifications (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; also passed to Telegram when registering the webhook.
TELEGRAM_WEBHOOK_SECRET=
